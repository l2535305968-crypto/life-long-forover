# 把这个文件复制成 .env，然后填上你自己的 Key。
# .env 不要提交、不要发给别人。老人的故事和这把钥匙都只留在你这台机器上。

# DeepSeek 的 Key，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=

# 对话模型。deepseek-chat 便宜够用，长访谈也扛得住。
DEEPSEEK_MODEL=deepseek-chat

# 接口地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本机服务端口
PORT=8788

# 监听地址。0.0.0.0 表示同一个 WiFi 下的手机也能连上；
# 只想自己电脑上试就改成 127.0.0.1
HOST=0.0.0.0

# 每个 IP 每分钟最多请求几次。防止把 Key 用穿。
RATE_PER_MINUTE=40

# ---- 语音系统（可选，配了自动生效） ----

# 本地方言识别（FunASR）：起好 tools/funasr_asr_server.py 后填这个地址，
# /api/asr 会优先走本地（免费无限额），本地挂了才回讯飞。不填就只用讯飞。
# LOCAL_ASR_URL=http://127.0.0.1:8789/asr

# 温暖声音朗读（Qwen3-TTS）：起好 tools/qwen3_tts_server.py 后填这个地址，
# 前端 AI 的话会用暖声音念出来（不干瘪），服务没起时自动回退浏览器朗读。
# 不填默认 http://127.0.0.1:7861/tts，配了 TTS_URL 服务端 health 会报 hasTts:true。
TTS_URL=http://127.0.0.1:7861/tts

# ---- 讯飞语音识别（方言/普通话 ASR，可选） ----
# 到 https://console.xfyun.cn 申请「语音听写」服务后填入。
# 不填 / 本地 FunASR 没起时，/api/asr 会回退浏览器自带语音识别，方言听写会弱一些。
XF_APPID=
XF_API_KEY=
XF_API_SECRET=

# ---- 本地工具（智能体 → 交互键 → 跑本机脚本，默认关闭） ----
# 安全开关：默认关。只有设成 1 才会开放 /api/v1/tools/* 接口。
# 开了之后，手机 / 浏览器能通过「智能体 → 运行」键，触发脚本在你电脑上执行
# （比如 B站视频合成）。能跑的脚本白名单在 server/tools.mjs，只能跑那里的，
# 手机端不能传任意命令，风险受控；但毕竟会暴露"本机执行脚本"能力，默认关。
# ENABLE_TOOLS=1